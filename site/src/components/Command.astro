---
/** A shell command with a button that copies it. */
interface Props {
  command: string;
  /** `pill` sits beside a button; `block` fills its column. */
  shape?: 'pill' | 'block';
}

const { command, shape = 'block' } = Astro.props;
---

<button type="button" class:list={['command', `as-${shape}`]} data-copy={command}>
  <span class="prompt" aria-hidden="true">$</span>
  <code>{command}</code>
  <span class="state" aria-hidden="true">
    <svg class="copy" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4">
      <rect x="5.5" y="5.5" width="8" height="8" rx="2"></rect>
      <path d="M10.5 3.5v-.2a1.8 1.8 0 0 0-1.8-1.8H4.3a1.8 1.8 0 0 0-1.8 1.8v4.4a1.8 1.8 0 0 0 1.8 1.8h.2"></path>
    </svg>
    <svg class="done" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="m3.5 8.5 3 3 6-7" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </span>
  <span class="sr-only" role="status"></span>
</button>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const status = button.querySelector('[role="status"]');
    let timer = 0;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
      } catch {
        return;
      }
      button.dataset.copied = '';
      if (status) status.textContent = 'Copied';
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        delete button.dataset.copied;
        if (status) status.textContent = '';
      }, 1600);
    });
  }
</script>

<style>
  .command {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    max-width: 100%;
    border: 1px solid var(--color-line);
    background: rgb(20 19 18 / 0.6);
    backdrop-filter: blur(14px);
    color: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-align: left;
    cursor: copy;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }

  .command:hover {
    border-color: rgb(244 241 233 / 0.24);
    background: rgb(36 34 32 / 0.7);
  }

  .as-pill {
    height: 2.875rem;
    padding-inline: 1.2rem 1rem;
    border-radius: 999px;
  }

  .as-block {
    display: flex;
    width: 100%;
    padding: 1.1rem 1.25rem;
    border-radius: 1rem;
    font-size: 0.9375rem;
  }

  code {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* In a block, a long command wraps on a narrow screen and stays readable. */
  .as-block code {
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .prompt {
    color: var(--color-flame);
    user-select: none;
  }

  .state {
    display: grid;
    flex: none;
    margin-left: auto;
    color: var(--color-ash);
  }

  .state svg {
    grid-area: 1 / 1;
    transition:
      opacity 0.2s,
      scale 0.2s var(--ease-settle);
  }

  .done {
    opacity: 0;
    scale: 0.6;
    color: var(--color-flame);
  }

  .command[data-copied] .copy {
    opacity: 0;
    scale: 0.6;
  }

  .command[data-copied] .done {
    opacity: 1;
    scale: 1;
  }
</style>
