---
/**
 * A sleeping agent's field, drawn after the app (AsleepLine in
 * Swiftr/Messages/MessagesPane.swift): a moon, how long it has slept, and Wake.
 */
import FieldRow from './FieldRow.astro';
---

<div class="asleep" data-art role="img" aria-label="The message field of a sleeping agent: a moon, Asleep for 2 h, and a Wake button">
  <div class="field">
    <div class="line">
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <path d="M12.6 10.3A5.6 5.6 0 0 1 5.4 3a5.6 5.6 0 1 0 7.2 7.3z"></path>
        <path d="M9.6 2.6h2.2L9.6 5.2h2.2M12.9 5.9h1.5l-1.5 1.8h1.5"></path>
      </svg>
      <span>Asleep for 2 h</span>
      <span class="wake">Wake</span>
    </div>
    <div class="text"></div>
    <FieldRow asleep />
  </div>
</div>

<style>
  .asleep {
    width: 100%;
    font-family: system-ui, sans-serif;
    font-size: 13px;
    line-height: 1.3;
    color: var(--app-ink);
  }

  .field {
    display: grid;
    gap: 8px;
    padding: 12px 9px 8px;
    border-radius: 20px;
    background: var(--app-field);
    container-type: inline-size;
  }

  .line {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-inline: 6px;
    color: var(--app-dim);
    font-size: 11px;
  }

  .line path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .wake {
    margin-left: auto;
    color: var(--app-accent);
  }

  .text {
    height: 17px;
  }

  /* Once, as the drawing comes into view: the agent goes to sleep. */
  .asleep[data-art='wait'] .line {
    opacity: 0;
  }

  .asleep[data-art='play'] .line {
    transition: opacity 0.6s ease-out 0.5s;
  }
</style>
