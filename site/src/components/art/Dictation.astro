---
/**
 * Dictation, drawn after the app (Swiftr/Dictation/DictationLook.swift and
 * DictationViews.swift): bars 2.5 points wide come in on the right, one every
 * twelfth of a second, and fade as they move left; the time spoken, a ✕ to
 * cancel; a line of light around the field in the accent and its two neighbors
 * on the color wheel; the microphone button filled while it listens.
 */
import FieldRow from './FieldRow.astro';

const barWidth = 2.5;
const step = 4.5;
const height = 30;
const count = 170;
const width = count * step;

/** A level that sounds like someone speaking, `t` seconds in: words, syllables, a breath now and then. */
function voice(t: number): number {
  const word = Math.sin(t * 2.2) + Math.sin(t * 0.9 + 1.3) * 0.6;
  if (word < -0.6) return 0.03;
  const syllable = Math.abs(Math.sin(t * 9.5)) * 0.55 + Math.abs(Math.sin(t * 4.1 + 0.7)) * 0.45;
  return Math.min(1, 0.16 + syllable * (0.5 + 0.32 * Math.max(0, word)));
}

/** Between 0.9 and 1, the same each time: a voice, not a curve. */
function grain(k: number): number {
  const x = Math.sin(k * 12.9898) * 43758.5453;
  return 0.9 + 0.1 * (x - Math.floor(x));
}

const bars = Array.from({ length: count }, (_, k) => {
  const level = voice(k / 12);
  const tall = Math.max(barWidth, height * Math.min(1, Math.pow(Math.max(0, level - 0.06) / 0.8, 1.35)) * grain(k));
  return { x: (k * step).toFixed(1), y: ((height - tall) / 2).toFixed(2), tall: tall.toFixed(2) };
});
---

<div class="dictation" data-art role="img" aria-label="The message field while you dictate: bars follow your voice, with the time spoken, and a line of light runs around the field">
  <span class="keycap"><span class="sign">⌥</span>option</span>

  <div class="field">
    <span class="edge wide"></span>
    <span class="edge soft"></span>
    <span class="edge line"></span>

    <div class="voice">
      <div class="wave">
        <svg viewBox={`0 0 ${width} ${height}`} width={width} height={height} aria-hidden="true">
          <defs>
            <linearGradient id="voice-ink" gradientUnits="userSpaceOnUse" x1={width - 460} x2={width} y1="0" y2="0">
              <stop offset="0" class="ink-0"></stop>
              <stop offset="0.5" class="ink-1"></stop>
              <stop offset="1" class="ink-2"></stop>
            </linearGradient>
          </defs>
          <g fill="url(#voice-ink)">
            {bars.map((bar) => <rect x={bar.x} y={bar.y} width={barWidth} height={bar.tall} rx={barWidth / 2} />)}
          </g>
        </svg>
      </div>
      <span class="clock">0:06</span>
      <span class="cancel">
        <svg viewBox="0 0 16 16" width="9" height="9" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" /></svg>
      </span>
    </div>

    <FieldRow mic="on" />
  </div>
</div>

<style>
  /* The light turns around the field. A registered angle can be animated. */
  @property --turn {
    syntax: '<angle>';
    inherits: true;
    initial-value: 215deg;
  }

  .dictation {
    /* The accent, and its neighbors a little before and after it on the color wheel. */
    --voice-0: #12acc6;
    --voice-1: var(--app-accent);
    --voice-2: #492be4;

    display: grid;
    gap: 1.25rem 1.75rem;
    align-items: center;
    justify-items: center;
    width: 100%;
    max-width: 46rem;
    margin-inline: auto;
    padding: 12px;
    font-family: system-ui, sans-serif;
    font-size: 13px;
    line-height: 1.3;
    color: var(--app-ink);
  }

  @media (min-width: 40rem) {
    .dictation {
      grid-template-columns: auto minmax(0, 1fr);
    }
  }


  /* The key you hold, as a Mac keyboard prints it. Held down here. */
  .keycap {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: space-between;
    width: 60px;
    height: 60px;
    padding: 7px 8px;
    border-radius: 11px;
    background: var(--app-page);
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.14),
      0 1px 0 1px rgb(0 0 0 / 0.12);
    color: var(--app-dim);
    font-size: 10.5px;
    translate: 0 2px;
  }

  .sign {
    color: var(--app-ink);
    font-size: 16px;
    line-height: 1;
  }

  .field {
    width: 100%;
  }

  .field {
    position: relative;
    display: grid;
    min-width: 0;
    container-type: inline-size;
    gap: 9px;
    padding: 13px 9px 8px;
    border-radius: 20px;
    background: var(--app-field);
  }

  /* Three strokes of the same turning colors: a line, a soft glow, a wide one. */
  .edge {
    position: absolute;
    border-radius: inherit;
    background: conic-gradient(
      from var(--turn),
      var(--voice-0),
      var(--voice-1),
      var(--voice-2),
      var(--voice-1),
      var(--voice-0)
    );
    pointer-events: none;
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
  }

  .edge.line {
    inset: -0.5px;
    padding: 1.25px;
    opacity: 0.9;
  }

  .edge.soft {
    inset: -2.5px;
    padding: 5px;
    border-radius: 22.5px;
    opacity: 0.42;
    filter: blur(2.5px);
  }

  .edge.wide {
    inset: -7px;
    padding: 14px;
    border-radius: 27px;
    opacity: 0.16;
    filter: blur(7px);
  }

  .voice {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 30px;
    padding-inline: 6px 2px;
  }

  /* The bars keep their own width whatever the field's: the row shows the newest, on the right. */
  .wave {
    position: relative;
    flex: 1;
    height: 30px;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 38%);
    mask-image: linear-gradient(to right, transparent, #000 38%);
  }

  .wave svg {
    position: absolute;
    top: 0;
    right: 0;
    max-width: none;
  }

  .ink-0 {
    stop-color: var(--voice-0);
  }

  .ink-1 {
    stop-color: var(--voice-1);
  }

  .ink-2 {
    stop-color: var(--voice-2);
  }

  .clock {
    color: var(--app-dim);
    font-size: 11px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .cancel {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--app-faint);
    color: var(--app-dim);
  }

  .cancel path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
  }

  /* Once, as the drawing comes into view: the bars move left at the app's pace
     (4.5 points every twelfth of a second) while the light makes half a turn. */
  .dictation[data-art='wait'] .wave svg {
    translate: 150px 0;
  }

  .dictation[data-art='wait'] .edge {
    opacity: 0;
  }

  /* Not held yet: the key stands higher, over a deeper shadow. */
  .dictation[data-art='wait'] .keycap {
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.14),
      0 3px 0 1px rgb(0 0 0 / 0.12);
    translate: 0 0;
  }

  .dictation[data-art='play'] .keycap {
    transition:
      translate 0.12s ease-out 0.25s,
      box-shadow 0.12s ease-out 0.25s;
  }

  .dictation[data-art='play'] .wave svg {
    animation: voice-in 2.8s cubic-bezier(0.3, 0.3, 0.5, 1) 0.4s both;
  }

  .dictation[data-art='play'] .field {
    animation: voice-turn 3.2s cubic-bezier(0.3, 0.3, 0.4, 1) 0.4s both;
  }

  .dictation[data-art='play'] .edge {
    animation: voice-edge 0.5s ease-out 0.4s both;
  }

  @keyframes voice-in {
    from {
      translate: 150px 0;
    }
  }

  @keyframes voice-turn {
    from {
      --turn: 35deg;
    }
  }

  @keyframes voice-edge {
    from {
      opacity: 0;
    }
  }
</style>
