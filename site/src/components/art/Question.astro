---
/**
 * An agent's question as a card, drawn after the app (QuestionCard, CardFrame,
 * CardHeader, ChoiceRow and CardKeyCap in Swiftr/Messages): a blue-edged card,
 * a badge and a title, the question, numbered choices, a field for your own
 * words, and the buttons. It stays still: with one question, a click on a
 * choice sends the answer at once, so there is no chosen state to show.
 */
const choices = [
  { label: 'In memory', detail: 'Fastest. Gone when the app quits.' },
  { label: 'On disk', detail: 'Kept between launches, up to 200 MB.' },
  { label: 'Both', detail: 'Memory first, disk behind it.' },
];
---

<div class="question" role="img" aria-label="A question from Claude shown as a card: three numbered choices, a field for your own words, and Skip and Submit buttons">
  <div class="card">
    <div class="head">
      <span class="badge">
        <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
          <path class="bubble" d="M3.6 2.2h8.8a2 2 0 0 1 2 2v5.4a2 2 0 0 1-2 2H8.6l-3.2 2.6v-2.6H3.6a2 2 0 0 1-2-2V4.2a2 2 0 0 1 2-2z"></path>
          <path class="mark" d="M6.6 5.6a1.5 1.5 0 1 1 2.2 1.3c-.5.3-.8.6-.8 1.1"></path>
          <circle class="dot" cx="8" cy="9.7" r="0.55"></circle>
        </svg>
      </span>
      <strong>Claude has a question</strong>
      <svg class="terminal" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <rect x="1.6" y="2.6" width="12.8" height="10.8" rx="2.2"></rect>
        <path d="M4.4 6.2 6.6 8l-2.200 1.800M8.200 10h3"></path>
      </svg>
    </div>

    <span class="topic">Cache</span>
    <p class="ask">Where should the thumbnails be kept?</p>

    <ul>
      {
        choices.map((choice, i) => (
          <li>
            <span class="key">{i + 1}</span>
            <span>
              {choice.label}
              <small>{choice.detail}</small>
            </span>
          </li>
        ))
      }
    </ul>

    <div class="own">Or answer in your own words…</div>

    <div class="buttons">
      <span class="button">Chat About This</span>
      <span class="button">Skip</span>
      <span class="button submit">Submit</span>
    </div>
  </div>
</div>

<style>
  .question {
    --blue: #0a7aff;

    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
    font-family: system-ui, sans-serif;
    font-size: 13px;
    line-height: 1.35;
    color: var(--app-ink);
  }

  .card {
    display: grid;
    gap: 10px;
    padding: 18px;
    border: 1px solid color-mix(in srgb, var(--blue) 26%, transparent);
    border-radius: 22px;
    background: var(--app-page);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.06);
  }

  .head {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .badge {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 6.5px;
    background: color-mix(in srgb, var(--blue) 16%, transparent);
    color: var(--blue);
  }

  .bubble {
    fill: currentColor;
  }

  .mark {
    fill: none;
    stroke: var(--app-page);
    stroke-width: 1.3;
    stroke-linecap: round;
  }

  .dot {
    fill: var(--app-page);
  }

  strong {
    font-weight: 600;
  }

  .topic {
    justify-self: start;
    padding: 2px 7px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--blue) 16%, transparent);
    font-size: 9.6px;
    font-weight: 600;
  }

  .ask {
    font-size: 13.3px;
    font-weight: 500;
  }

  ul {
    display: grid;
    gap: 2px;
  }

  li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 6px 8px;
    border-radius: 9px;
    font-size: 12.4px;
  }

  small {
    display: block;
    margin-top: 2px;
    color: var(--app-dim);
    font-size: 10.7px;
  }

  .key {
    flex: none;
    min-width: 18px;
    border-radius: 4.5px;
    background: var(--app-faint);
    box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 0.14);
    color: var(--app-dim);
    font-size: 9.1px;
    font-weight: 600;
    line-height: 18px;
    text-align: center;
  }

  .own {
    padding: 7px 10px;
    border-radius: 10px;
    background: rgb(0 0 0 / 0.06);
    color: var(--app-dim);
    font-size: 12.4px;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 2px;
  }

  .button {
    padding: 3px 9px;
    border-radius: 6px;
    background: #fff;
    box-shadow:
      0 0 0 0.5px rgb(0 0 0 / 0.16),
      0 0.5px 1.5px rgb(0 0 0 / 0.14);
    font-size: 12px;
    white-space: nowrap;
  }

  /* Nothing is chosen yet, so Submit waits: with one question, a click on a choice sends it. */
  .submit {
    margin-left: auto;
    background: var(--app-accent);
    box-shadow: 0 0.5px 1.5px rgb(0 0 0 / 0.2);
    color: #fff;
    opacity: 0.45;
  }

  .terminal {
    margin-left: auto;
    color: var(--app-dim);
  }

  .terminal :is(path, rect) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
