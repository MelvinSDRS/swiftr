{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "swiftr-www",
  "main": "./redirect.ts",
  "compatibility_date": "2026-11-17",
  // Only this address: the site itself is the Worker in ../wrangler.jsonc.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "www.swiftr.dev", "custom_domain": true }]
}
